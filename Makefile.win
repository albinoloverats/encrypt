.PHONY: clean distclean test

APP            = encrypt
APP_SIG        = encrypt-signed
CC             = gcc
WRES           = windres
NSIS           = C:/Program\ Files\ \(x86\)/NSIS/makensis.exe
SIGN           = osslsigncode

COMMON_SRC     = common/src/error.c common/src/mem.c common/src/ccrypt.c common/src/list.c common/src/tlv.c common/src/version.c common/src/config.c common/src/cli.c common/src/dir.c common/src/ecc.c common/src/non-gnu.c
CLI_SRC        = ${COMMON_SRC} src/main.c src/crypt.c src/encrypt.c src/decrypt.c src/crypt_io.c
GUI_SRC        = ${CLI_SRC} src/gui-gtk.c
CORE_SRC       = ${COMMON_SRC} src/crypt.c src/encrypt.c src/decrypt.c src/crypt_io.c
MISC           = src/misc.h
IO_TEST        = test-crypt-io.exe
FLOW_TEST      = test-crypt-flow.exe
RC             = src/encrypt_private.rc
RES            = src/encrypt_private.res

BUILD_OS       = Windows $(shell cmd.exe /c ver | tr -d '\r' | sed -e 's/^.*\[//' -e 's/\]$$//')
VERSION        = $(shell sed -e 's/[[:space:]]*$//' VERSION)
VERSION_SH     = scripts/version.sh

GUI_CFLAGS     = ${CFLAGS} -Wall -Wextra -std=gnu99 `pkg-config --cflags libgcrypt` -pipe -O2 -mwindows -Wformat=0 `pkg-config --cflags gtk+-3.0 gmodule-2.0`
GUI_CPPFLAGS   = ${CPPFLAGS} -D_GNU_SOURCE -D_FILE_OFFSET_BITS=64 -DGCRYPT_NO_DEPRECATED -DUSE_GCRYPT -D__USE_MINGW_ANSI_STDIO -DBUILD_GUI -Isrc
TEST_CFLAGS    = ${CFLAGS} -Wall -Wextra -std=gnu99 `pkg-config --cflags libgcrypt cmocka` -pipe -O2
TEST_CPPFLAGS  = ${CPPFLAGS} -Isrc -Icommon -D_GNU_SOURCE -D_FILE_OFFSET_BITS=64 -DGCRYPT_NO_DEPRECATED -DUSE_GCRYPT -D__USE_MINGW_ANSI_STDIO

DEBUG_CFLAGS   = -O0 -ggdb -pg -mconsole
DEBUG_CPPFLAGS = -D__DEBUG__ -D__DEBUG_GUI__ -DMALLOC_CHECK_=1

GUI_LIBS       = `pkg-config --libs libgcrypt` -lpthread -lcurl -llzma `pkg-config --libs gtk+-3.0 gmodule-2.0`
TEST_LIBS      = `pkg-config --libs libgcrypt cmocka` -lpthread -lcurl -llzma

INST           = encrypt.nsi
PKG            = encrypt-${VERSION}-install.exe
PKG_SIG        = encrypt-${VERSION}-install-signed.exe

RESOPTS        = --output-format=coff --input-format=rc
SIGOPTS        = -verbose -certs signing/authenticode.spc -key signing/authenticode.key -n "${APP}" -i "https://albinoloverats.net/"

all: sign

debug: debug-gui

winres:
	 @${WRES} -i ${RC} ${RESOPTS} -o ${RES}
	-@echo -e "compiled Windows application metadata"

gui: winres
	 @sh ${VERSION_SH} "$(strip ${GUI_CFLAGS})" "$(strip ${GUI_CPPFLAGS})" "$(BUILD_OS)"
	 @${CC} ${GUI_CFLAGS} ${GUI_CPPFLAGS} ${GUI_SRC} ${RES} ${GUI_LIBS} -o ${APP}
	-@echo -e "built ‘`echo -e ${GUI_SRC} | sed 's/ /’\n      ‘/g'`’ → ‘${APP}’"

test:
	 @${MAKE} -C common test
	 @sh ${VERSION_SH} "$(strip ${TEST_CFLAGS})" "$(strip ${TEST_CPPFLAGS} -I.)" "$(BUILD_OS)"
	 @${CC} ${TEST_CFLAGS} ${TEST_CPPFLAGS} -I. ${CORE_SRC} test/test_crypt_io.c ${TEST_LIBS} -o ${IO_TEST}
	 @./${IO_TEST}
	 @sh ${VERSION_SH} "$(strip ${TEST_CFLAGS})" "$(strip ${TEST_CPPFLAGS} -I.)" "$(BUILD_OS)"
	 @${CC} ${TEST_CFLAGS} ${TEST_CPPFLAGS} -I. ${CORE_SRC} test/test_crypt_flow.c ${TEST_LIBS} -o ${FLOW_TEST}
	 @./${FLOW_TEST}

sign: gui
	 @${SIGN} ${SIGOPTS} -in ${APP}.exe ${APP_SIG}.exe
	-@echo -e "signed ‘${APP}’ → ‘${APP_SIG}’"
	-@mv -v ${APP_SIG} ${APP}

debug-gui: winres
	 @sh ${VERSION_SH} "$(strip ${GUI_CFLAGS} ${DEBUG_CFLAGS})" "$(strip ${GUI_CPPFLAGS} ${DEBUG_CPPFLAGS})" "$(BUILD_OS)"
	 @${CC} ${GUI_CFLAGS} ${GUI_CPPFLAGS} ${GUI_SRC} ${RES} ${DEBUG_CFLAGS} ${DEBUG_CPPFLAGS} ${GUI_LIBS} -o ${APP}
	-@echo -e "built ‘`echo -e ${GUI_SRC} | sed 's/ /’\n      ‘/g'`’ → ‘${APP}’"

installer:
	 @${NSIS} ${INST}
	 @${SIGN} ${SIGOPTS} -in ${PKG} -out ${PKG_SIG}
	-@echo -e "signed ‘${PKG}’ → ‘${PKG_SIG}’"
	-@mv -v ${PKG_SIG} ${PKG}

clean:
	 @rm -fv ${APP} ${APP_SIG} ${MISC} ${RES} ${IO_TEST} ${FLOW_TEST}
	 @${MAKE} -C common clean

distclean: clean
	 @rm -fv ${PKG} ${PKG_SIG} gmon.out
